FROM python:3.13-slim

WORKDIR /app/backend

RUN pip install uv

COPY backend/pyproject.toml ./
RUN uv sync --no-dev

COPY backend/ .
COPY vss.json /app/vss.json
COPY profiles/ /app/profiles/

ENV VSS_JSON_PATH=/app/vss.json

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]