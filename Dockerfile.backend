FROM python:3.13-slim

WORKDIR /

RUN pip install uv

COPY /backend/pyproject.toml ./
RUN uv sync --no-dev

COPY ./backend/ .
# The VSS specification lives at the repo root and is read at startup.
COPY vss.json /vss.json
COPY profiles/ /profiles/
ENV VSS_JSON_PATH=/vss.json

EXPOSE 8000

CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
