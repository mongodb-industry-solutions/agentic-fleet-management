# Frontend configuration.
#
#   cp env.example .env.local
#
# Nothing here is required for local development. The defaults work when the
# backend runs on port 8000 on the same machine.
#
# No secrets belong in this file. Anything prefixed NEXT_PUBLIC_ is compiled
# into the browser bundle and is readable by anyone using the app.


# Base URL the browser uses for API calls. Empty means relative /api paths,
# which Next then proxies to the backend. Leave it empty unless the API is on a
# different host that the browser reaches directly.
NEXT_PUBLIC_API_URL=

# Where Next forwards /api/* on the server side. Defaults to http://127.0.0.1:8000
# for local development. Docker Compose sets this to http://fleet-backend:8000.
# BACKEND_URL=http://127.0.0.1:8000
