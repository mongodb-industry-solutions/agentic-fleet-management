# Backend configuration.
#
#   cp env.example .env
#
# Fill in the values marked REQUIRED NOW. Everything else can stay as it is
# until the step of the adoption path that needs it. The data quality report
# runs with none of these set.


# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# REQUIRED FROM STEP 2. Leave MONGODB_URI empty and the pipeline still runs and
# still produces a quality report; it simply has nowhere to persist results.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database to use inside that cluster. Created on first write.
DATABASE_NAME=fleet

# Shows up in Atlas connection metrics, so leave it recognisable.
APP_NAME=agentic-fleet-management


# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# Which directory under profiles/ to load. Everything that differs between fleet
# operators lives there: mapping files, service area, trust seeds, questions.
# 'leafy' ships with the repo and runs on generated sample data.
PROFILE=leafy

# Where the COVESA VSS export lives. Defaults to vss.json at the repo root, so
# only set this if you move it. Docker sets it to /vss.json.
# VSS_JSON_PATH=/absolute/path/to/vss.json


# ---------------------------------------------------------------------------
# Voyage AI, for embeddings and reranking
# ---------------------------------------------------------------------------
# REQUIRED FROM STEP 4. Used for multimodal embeddings and cross-encoder
# reranking. Get a key at https://dash.voyageai.com
VOYAGE_API_KEY=

# Override the models if needed. Defaults come from config/config.json.
# VOYAGE_EMBEDDING_MODEL=voyage-multimodal-3
# VOYAGE_RERANK_MODEL=rerank-2.5


# ---------------------------------------------------------------------------
# AWS Bedrock, for Claude
# ---------------------------------------------------------------------------
# REQUIRED FROM STEP 4. Reasoning runs on Claude through Bedrock, using the
# named profile from ~/.aws/credentials rather than inline keys.
AWS_REGION=us-east-1
AWS_PROFILE=

# Override the models if needed. Defaults come from config/config.json.
# Confirm these ids are enabled in your Bedrock account and region first.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_FANOUT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# If you use inline credentials rather than a profile, set these instead of
# AWS_PROFILE. A named profile is preferred.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Allowed browser origins. The frontend proxies through Next, so this only
# matters if something calls the API directly.
ORIGINS=http://localhost:3000
