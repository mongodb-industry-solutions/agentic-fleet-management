maximum": 100}, "LightIntensity": {"type": "number", "description": "Light intensity outside the vehicle. 0 = No light detected, 100 = Fully lit.", "minimum": 0, "maximum": 100}, "RoadSurfaceCondition": {"type": "integer", "description": "Assessed condition of the road surface beneath or ahead of the vehicle.", "minimum": 0, "maximum": 255}, "RoadSurfaceTemperature": {"type": "number", "description": "Temperature of the road surface beneath or ahead of the vehicle."}, "RoadSurfaceContaminant": {"type": "integer", "description": "Detected non-weather surface contaminant on the road beneath or ahead of the vehicle.", "minimum": 0, "maximum": 255}, "RoadObstruction": {"type": "integer", "description": "Type of road obstruction detected ahead of the vehicle.", "minimum": 0, "maximum": 255}, "VisibilityCondition": {"type": "integer", "description": "Assessed visibility condition outside the vehicle.", "minimum": 0, "maximum": 255}, "VisibilityDistance": {"type": "number", "description": "Estimated visible distance ahead of the vehicle in current conditions.", "minimum": 0}, "PrecipitationType": {"type": "integer", "description": "Type of precipitation currently detected outside the vehicle.", "minimum": 0, "maximum": 255}, "PrecipitationIntensity": {"type": "number", "description": "Precipitation intensity in millimeters per hour.", "minimum": 0}, "AirPressure": {"type": "number", "description": "Atmospheric air pressure outside the vehicle."}, "WindSpeed": {"type": "number", "description": "Surface wind speed outside the vehicle.", "minimum": 0}, "WindDirection": {"type": "number", "description": "Wind direction in degrees (meteorological convention, 0 = North, 90 = East).", "minimum": 0, "maximum": 360}, "AirQuality": {"type": "object", "description": "Signals describing the composition of the ambient air outside the vehicle.", "properties": {"PM1": {"type": "number", "description": "Mass concentration of particulate matter with aerodynamic diameter of 1 micrometer or less (PM1.0).", "minimum": 0}, "PM25": {"type": "number", "description": "Mass concentration of particulate matter with aerodynamic diameter of 2.5 micrometers or less (PM2.5).", "minimum": 0}, "PM10": {"type": "number", "description": "Mass concentration of particulate matter with aerodynamic diameter of 10 micrometers or less (PM10).", "minimum": 0}, "CO2": {"type": "number", "description": "Carbon dioxide (CO2) concentration.", "minimum": 0}, "NO2": {"type": "number", "description": "Nitrogen dioxide (NO2) concentration.", "minimum": 0}, "Ozone": {"type": "number", "description": "Ozone (O3) concentration.", "minimum": 0}, "TVOC": {"type": "number", "description": "Total volatile organic compounds (TVOC) concentration.", "minimum": 0}}}}}, "Service": {"type": "object", "description": "Service data.", "properties": {"IsServiceDue": {"type": "boolean", "description": "Indicates if vehicle needs service (of any kind). True = Service needed now or in the near future. False = No known need for service."}, "DistanceToService": {"type": "number", "description": "Remaining distance to service (of any kind). Negative values indicate service overdue."}, "TimeToService": {"type": "integer", "description": "Remaining time to service (of any kind). Negative values indicate service overdue.", "minimum": -2147483648, "maximum": 2147483647}}}, "Connectivity": {"type": "object", "description": "Connectivity data.", "properties": {"IsConnectivityAvailable": {"type": "boolean", "description": "Indicates if connectivity between vehicle and cloud is available. True = Connectivity is available. False = Connectivity is not available."}}}, "VersionVSS": {"type": "object", "description": "Supported Version of VSS.", "properties": {"Major": {"type": "integer", "description": "Supported Version of VSS - Major version.", "minimum": 0, "maximum": 4294967295}, "Minor": {"type": "integer", "description": "Supported Version of VSS - Minor version.", "minimum": 0, "maximum": 4294967295}, "Patch": {"type": "integer", "description": "Supported Version of VSS - Patch version.", "minimum": 0, "maximum": 4294967295}, "Label": {"type": "string", "description": "Label to further describe the version."}}}, "VehicleIdentification": {"type": "object", "description": "Attributes that identify a vehicle.", "properties": {"VIN": {"type": "string", "description": "17-character Vehicle Identification Number (VIN) as defined by ISO 3779."}, "WMI": {"type": "string", "description": "3-character World Manufacturer Identification (WMI) as defined by ISO 3780."}, "Brand": {"type": "string", "description": "Vehicle brand or manufacturer."}, "Model": {"type": "string", "description": "Vehicle model."}, "Year": {"type": "integer", "description": "Model year of the vehicle.", "minimum": 0, "maximum": 65535}, "AcrissCode": {"type": "string", "description": "The ACRISS Car Classification Code is a code used by many car rental companies."}, "BodyType": {"type": "string", "description": "Indicates the design and body style of the vehicle (e.g. station wagon, hatchback, etc.)."}, "DateVehicleFirstRegistered": {"type": "string", "description": "The date in ISO 8601 format of the first registration of the vehicle with the respective public authorities."}, "LicensePlate": {"type": "string", "description": "The license plate of the vehicle."}, "MeetsEmissionStandard": {"type": "string", "description": "Indicates that the vehicle meets the respective emission standard."}, "ProductionDate": {"type": "string", "description": "The date in ISO 8601 format of production of the item, e.g. vehicle."}, "PurchaseDate": {"type": "string", "description": "The date in ISO 8601 format of the item e.g. vehicle was purchased by the current owner."}, "VehicleModelDate": {"type": "string", "description": "The release date in ISO 8601 format of a vehicle model (often used to differentiate versions of the same make and model)."}, "VehicleConfiguration": {"type": "string", "description": "A short text indicating the configuration of the vehicle, e.g. '5dr hatchback ST 2.5 MT 225 hp' or 'limited edition'."}, "VehicleSeatingCapacity": {"type": "integer", "description": "The number of passengers that can be seated in the vehicle, both in terms of the physical space available, and in terms of limitations set by law.", "minimum": 0, "maximum": 65535}, "VehicleSpecialUsage": {"type": "string", "description": "Indicates whether the vehicle has been used for special purposes, like commercial rental, driving school."}, "VehicleExteriorColor": {"type": "string", "description": "The main color of the exterior within the basic color palette (eg. red, blue, black, white, ...)."}, "VehicleInteriorColor": {"type": "string", "description": "The color or color combination of the interior of the vehicle."}, "VehicleInteriorType": {"type": "string", "description": "The type or material of the interior of the vehicle (e.g. synthetic fabric, leather, wood, etc.)."}, "KnownVehicleDamages": {"type": "string", "description": "A textual description of known damages, both repaired and unrepaired."}, "OptionalExtras": {"type": "array", "description": "Optional extras refers to all car equipment options that are not installed as standard by the manufacturer.", "items": {"type": "string"}}}}, "LowVoltageSystemState": {"type": "string", "description": "State of the supply voltage of the control units (usually 12V).", "enum": ["UNDEFINED", "LOCK", "OFF", "ACC", "ON", "START"]}, "LowVoltageBattery": {"type": "object", "description": "Signals related to low voltage battery.", "properties": {"NominalVoltage": {"type": "integer", "description": "Nominal Voltage of the battery.", "minimum": 0, "maximum": 65535}, "NominalCapacity": {"type": "integer", "description": "Nominal capacity of the low voltage battery.", "minimum": 0, "maximum": 65535}, "CurrentVoltage": {"type": "number", "description": "Current Voltage of the low voltage battery."}, "CurrentCurrent": {"type": "number", "description": "Current current flowing in/out of the low voltage battery. Positive = Current flowing in to battery, e.g. during charging or driving. Negative = Current flowing out of battery, e.g. when using the battery to start a combustion engine."}}}, "Speed": {"type": "number", "description": "Vehicle speed."}, "TraveledDistance": {"type": "integer", "description": "Odometer reading, total distance traveled during the lifetime of the vehicle.", "minimum": 0, "maximum": 4294967295}, "TraveledDistanceSinceStart": {"type": "integer", "description": "Distance traveled since start of current trip.", "minimum": 0, "maximum": 4294967295}, "StartTime": {"type": "string", "description": "Start time of current or latest trip, formatted according to ISO 8601 with UTC time zone."}, "TripDuration": {"type": "number", "description": "Duration of latest trip."}, "TripMeterReading": {"type": "integer", "description": "Trip meter reading.", "minimum": 0, "maximum": 4294967295}, "IsBrokenDown": {"type": "boolean", "description": "Vehicle breakdown or any similar event causing vehicle to stop on the road, that might pose a risk to other road users. True = Vehicle broken down on the road, due to e.g. engine problems, flat tire, out of gas, brake problems. False = Vehicle not broken down."}, "IsMoving": {"type": "boolean", "description": "Indicates whether the vehicle is stationary or moving."}, "AverageSpeed": {"type": "number", "description": "Average speed for the current trip."}, "Acceleration": {"type": "object", "description": "Spatial acceleration. Axis definitions according to ISO 8855.", "properties": {"Longitudinal": {"type": "number", "description": "Vehicle acceleration in X (longitudinal acceleration)."}, "Lateral": {"type": "number", "description": "Vehicle acceleration in Y (lateral acceleration)."}, "Vertical": {"type": "number", "description": "Vehicle acceleration in Z (vertical acceleration)."}}}, "AngularVelocity": {"type": "object", "description": "Spatial rotation. Axis definitions according to ISO 8855.", "properties": {"Roll": {"type": "number", "description": "Vehicle rotation rate along X (longitudinal)."}, "Pitch": {"type": "number", "description": "Vehicle rotation rate along Y (lateral)."}, "Yaw": {"type": "number", "description": "Vehicle rotation rate along Z (vertical)."}}}, "Orientation": {"type": "object", "description": "Spatial orientation. Axis definitions according to ISO 8855.", "properties": {"Roll": {"type": "number", "description": "Vehicle rotation (tilt) around X (longitudinal). Positive values = right side down.", "minimum": -180, "maximum": 180}, "Pitch": {"type": "number", "description": "Vehicle rotation (tilt) around Y (lateral). Positive values = nose up.", "minimum": -180, "maximum": 180}, "Yaw": {"type": "number", "description": "Vehicle rotation around Z (vertical) relative to geographic north.", "minimum": 0, "maximum": 360}}}, "RoofLoad": {"type": "integer", "description": "The permitted total weight of cargo and installations (e.g. a roof rack) on top of the vehicle.", "minimum": -32768, "maximum": 32767}, "CargoVolume": {"type": "number", "description": "The available volume for cargo or luggage. For automobiles, this is usually the trunk volume.", "minimum": 0}, "EmissionsCO2": {"type": "integer", "description": "The CO2 emissions.", "minimum": -32768, "maximum": 32767}, "CurrentOverallWeight": {"type": "integer", "description": "Current overall Vehicle weight. Including passengers, cargo and other load inside the car.", "minimum": 0, "maximum": 65535}, "CurbWeight": {"type": "integer", "description": "Vehicle curb weight, including all liquids and full tank of fuel, but no cargo or passengers.", "minimum": 0, "maximum": 65535}, "GrossWeight": {"type": "integer", "description": "Curb weight of vehicle, including all liquids and full tank of fuel and full load of cargo and passengers.", "minimum": 0, "maximum": 65535}, "MaxTowWeight": {"type": "integer", "description": "Maximum weight of trailer.", "minimum": 0, "maximum": 65535}, "MaxTowBallWeight": {"type": "integer", "description": "Maximum vertical weight on the tow ball of a trailer.", "minimum": 0, "maximum": 65535}, "Length": {"type": "integer", "description": "Overall vehicle length.", "minimum": 0, "maximum": 65535}, "Height": {"type": "integer", "description": "Overall vehicle height.", "minimum": 0, "maximum": 65535}, "WidthExcludingMirrors": {"type": "integer", "description": "Overall vehicle width excluding mirrors, as defined by SAE J1100-2009 W103.", "minimum": 0, "maximum": 65535}, "WidthIncludingMirrors": {"type": "integer", "description": "Overall vehicle width including mirrors, as defined by SAE J1100-2009 W144.", "minimum": 0, "maximum": 65535}, "WidthFoldedMirrors": {"type": "integer", "description": "Overall vehicle width with mirrors folded, as defined by SAE J1100-2009 W145.", "minimum": 0, "maximum": 65535}, "TurningDiameter": {"type": "integer", "description": "Minimum turning diameter, Wall-to-Wall, as defined by SAE J1100-2009 D102.", "minimum": 0, "maximum": 65535}, "Trailer": {"type": "object", "description": "Trailer signals.", "properties": {"IsConnected": {"type": "boolean", "description": "Signal indicating if trailer is connected or not."}}}, "CurrentLocation": {"type": "object", "description": "The current latitude and longitude of the vehicle.", "properties": {"Timestamp": {"type": "string", "description": "Timestamp from GNSS system for current location, formatted according to ISO 8601 with UTC time zone."}, "Latitude": {"type": "number", "description": "Current latitude of vehicle in WGS 84 geodetic coordinates, as measured at the position of GNSS receiver antenna.", "minimum": -90, "maximum": 90}, "Longitude": {"type": "number", "description": "Current longitude of vehicle in WGS 84 geodetic coordinates, as measured at the position of GNSS receiver antenna.", "minimum": -180, "maximum": 180}, "Heading": {"type": "number", "description": "Current heading relative to geographic north. 0 = North, 90 = East, 180 = South, 270 = West.", "minimum": 0, "maximum": 360}, "HorizontalAccuracy": {"type": "number", "description": "Accuracy of the latitude and longitude coordinates."}, "Altitude": {"type": "number", "description": "Current altitude relative to WGS 84 reference ellipsoid, as measured at the position of GNSS receiver antenna."}, "VerticalAccuracy": {"type": "number", "description": "Accuracy of altitude."}, "GNSSReceiver": {"type": "object", "description": "Information on the GNSS receiver used for determining current location.", "properties": {"FixType": {"type": "string", "description": "Fix status of GNSS receiver.", "enum": ["NONE", "TWO_D", "TWO_D_SATELLITE_BASED_AUGMENTATION", "TWO_D_GROUND_BASED_AUGMENTATION", "TWO_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION", "THREE_D", "THREE_D_SATELLITE_BASED_AUGMENTATION", "THREE_D_GROUND_BASED_AUGMENTATION", "THREE_D_SATELLITE_AND_GROUND_BASED_AUGMENTATION"]}, "MountingPosition": {"type": "object", "description": "Mounting position of GNSS receiver antenna relative to vehicle coordinate system. Axis definitions according to ISO 8855. Origin at center of (first) rear axle.", "properties": {"X": {"type": "integer", "description": "Mounting position of GNSS receiver antenna relative to vehicle coordinate system. Axis definitions according to ISO 8855. Origin at center of (first) rear axle. Positive values = forward of rear axle. Negative values = backward of rear axle.", "minimum": -32768, "maximum": 32767}, "Y": {"type": "integer", "description": "Mounting position of GNSS receiver antenna relative to vehicle coordinate system. Axis definitions according to ISO 8855. Origin at center of (first) rear axle. Positive values = left of origin. Negative values = right of origin. Left/Right is as seen from driver perspective, i.e. by a person looking forward.", "minimum": -32768, "maximum": 32767}, "Z": {"type": "integer", "description": "Mounting position of GNSS receiver on Z-axis. Axis definitions according to ISO 8855. Origin at center of (first) rear axle. Positive values = above center of rear axle. Negative values = below center of rear axle.", "minimum": -32768, "maximum": 32767}}}}}}}, "PowerOptimizeLevel": {"type": "integer", "description": "Power optimization level for this branch/subsystem. A higher number indicates more aggressive power optimization. Level 0 indicates that all functionality is enabled, no power optimization enabled. Level 10 indicates most aggressive power optimization mode, only essential functionality enabled.", "minimum": 0, "maximum": 10}, "IsAutoPowerOptimize": {"type": "boolean", "description": "Auto Power Optimization Flag When set to 'true', the system enables automatic power optimization, dynamically adjusting the power optimization level based on runtime conditions or features managed by the OEM. When set to 'false', manual control of the power optimization level is allowed."}, "Diagnostics": {"type": "object", "description": "Diagnostics data.", "properties": {"DTCCount": {"type": "integer", "description": "Number of Diagnostic Trouble Codes (DTC)", "minimum": 0, "maximum": 255}, "DTCList": {"type": "array", "description": "List of currently active DTCs formatted according OBD II (SAE-J2012DA_201812) standard ([P|C|B|U]XXXXX )", "items": {"type": "string"}}}}, "MotionManagement": {"type": "object", "description": "Motion Management Information.", "properties": {"ElectricAxle": {"type": "object", "description": "MotionManagement for a specific electric axle.", "properties": {"Row1": {"type": "object", "description": "MotionManagement for a specific electric axle.", "properties": {"Torque": {"type": "integer", "description": "Axle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueTarget": {"type": "integer", "description": "Target axle torque in torque control mode, positive sign for torque in forward direction, negative sign for torque in backward direction (ISO8855).", "minimum": -32768, "maximum": 32767}, "TorqueMaximum": {"type": "integer", "description": "Maximum momentarily available eAxle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueMinimum": {"type": "integer", "description": "Minimum momentarily available eAxle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueMaximumLimit": {"type": "integer", "description": "Maximum allowed eAxle torque in rotation speed control mode, positive sign for torque in forward direction, negative sign unused.", "minimum": -32768, "maximum": 32767}, "TorqueMinimumLimit": {"type": "integer", "description": "Minimum allowed axle torque in rotation speed control mode, positive sign unused, negative sign for torque in backward direction (ISO8855).", "minimum": -32768, "maximum": 32767}, "RotationalSpeed": {"type": "integer", "description": "Rotational speed for the specified axle, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedTarget": {"type": "integer", "description": "Target axle rotational speed in rotation speed control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedMaximumLimit": {"type": "integer", "description": "Maximum allowed axle rotational speed in torque control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedMinimumLimit": {"type": "integer", "description": "Minimum allowed axle rotational speed in torque control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}}}, "Row2": {"type": "object", "description": "MotionManagement for a specific electric axle.", "properties": {"Torque": {"type": "integer", "description": "Axle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueTarget": {"type": "integer", "description": "Target axle torque in torque control mode, positive sign for torque in forward direction, negative sign for torque in backward direction (ISO8855).", "minimum": -32768, "maximum": 32767}, "TorqueMaximum": {"type": "integer", "description": "Maximum momentarily available eAxle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueMinimum": {"type": "integer", "description": "Minimum momentarily available eAxle torque, positive sign for torque in forward direction, negative sign for torque in backward direction.", "minimum": -32768, "maximum": 32767}, "TorqueMaximumLimit": {"type": "integer", "description": "Maximum allowed eAxle torque in rotation speed control mode, positive sign for torque in forward direction, negative sign unused.", "minimum": -32768, "maximum": 32767}, "TorqueMinimumLimit": {"type": "integer", "description": "Minimum allowed axle torque in rotation speed control mode, positive sign unused, negative sign for torque in backward direction (ISO8855).", "minimum": -32768, "maximum": 32767}, "RotationalSpeed": {"type": "integer", "description": "Rotational speed for the specified axle, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedTarget": {"type": "integer", "description": "Target axle rotational speed in rotation speed control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedMaximumLimit": {"type": "integer", "description": "Maximum allowed axle rotational speed in torque control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}, "RotationalSpeedMinimumLimit": {"type": "integer", "description": "Minimum allowed axle rotational speed in torque control mode, positive sign for rotation in forward direction, negative sign for rotation in backward direction.", "minimum": -32768, "maximum": 32767}}}}}, "Brake": {"type": "object", "description": "MotionManagement related to braking (both frictions brakes and contribution from electric axles).", "properties": {"VehicleForceMaximum": {"type": "integer", "description": "Maximum longitudinal brake force request (FxWhlSum). Sum of all tyre longitudinal forces. Brake Force < 0N.", "minimum": -32768, "maximum": 0}, "VehicleForceElectricMinimumArbitrated": {"type": "integer", "description": "Brake system internally calculated regenerative force limit at vehicle level for eAxle actuation. Brake Force < 0N.", "minimum": -32768, "maximum": 0}, "VehicleForceElectric": {"type": "integer", "description": "Regenerative brake force request (FxWhlSum). Sum of all tyre longitudinal forces. Brake Force < 0N.", "minimum": -32768, "maximum": 0}, "VehicleForceDistributionFrontMaximum": {"type": "integer", "description": "Maximum distribution range request of FxWhlSum to front axle. 0% = Complete longitudinal brake force shall be shifted to rear axle. 50% = At most 50% shall be shifted to front axle. 100%  = Complete longitudinal brake force may be shifted to front axle.", "minimum": 0, "maximum": 100}, "VehicleForceDistributionFrontMinimum": {"type": "integer", "description": "Minimum distribution range request of FxWhlSum to front axle. 0% = Complete longitudinal brake force may be shifted to rear axle. 50% = At least 50% shall be shifted to front axle. 100% = Complete longitudinal brake force shal