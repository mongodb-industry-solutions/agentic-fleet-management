{"$schema": "https://json-schema.org/draft/2020-12/schema", "title": "Vehicle", "type": "object", "description": "High-level vehicle data.", "properties": {"Powertrain": {"type": "object", "description": "Powertrain data for battery management, etc.", "properties": {"CombustionEngine": {"type": "object", "description": "Engine-specific data, stopping at the bell housing.", "properties": {"EngineCode": {"type": "string", "description": "Engine code designation, as specified by vehicle manufacturer."}, "Displacement": {"type": "integer", "description": "Displacement in cubic centimetres.", "minimum": 0, "maximum": 65535}, "StrokeLength": {"type": "number", "description": "Stroke length in millimetres."}, "Bore": {"type": "number", "description": "Bore in millimetres."}, "Configuration": {"type": "string", "description": "Engine configuration.", "enum": ["UNKNOWN", "STRAIGHT", "V", "BOXER", "W", "ROTARY", "RADIAL", "SQUARE", "H", "U", "OPPOSED", "X"]}, "NumberOfCylinders": {"type": "integer", "description": "Number of cylinders.", "minimum": 0, "maximum": 65535}, "NumberOfValvesPerCylinder": {"type": "integer", "description": "Number of valves per cylinder.", "minimum": 0, "maximum": 65535}, "CompressionRatio": {"type": "string", "description": "Engine compression ratio, specified in the format 'X:1', e.g. '9.2:1'."}, "MaxPower": {"type": "integer", "description": "Peak power, in kilowatts, that engine can generate.", "minimum": 0, "maximum": 65535}, "MaxTorque": {"type": "integer", "description": "Peak torque, in newton meter, that the engine can generate.", "minimum": 0, "maximum": 65535}, "AspirationType": {"type": "string", "description": "Type of aspiration (natural, turbocharger, supercharger etc).", "enum": ["UNKNOWN", "NATURAL", "SUPERCHARGER", "TURBOCHARGER"]}, "IsRunning": {"type": "boolean", "description": "Engine Running. True if engine is rotating (Speed > 0)."}, "Speed": {"type": "number", "description": "Engine speed measured as rotations per minute."}, "EngineHours": {"type": "number", "description": "Accumulated time during engine lifetime with 'engine speed (rpm) > 0'."}, "IdleHours": {"type": "number", "description": "Accumulated idling time during engine lifetime. Definition of idling is not standardized."}, "EngineOil": {"type": "object", "description": "Signals related to the engine oil", "properties": {"Capacity": {"type": "number", "description": "Engine oil capacity in liters."}, "Level": {"type": "string", "description": "Engine oil level.", "enum": ["CRITICALLY_LOW", "LOW", "NORMAL", "HIGH", "CRITICALLY_HIGH"]}, "LifeRemaining": {"type": "integer", "description": "Remaining engine oil life in seconds. Negative values can be used to indicate that lifetime has been exceeded.", "minimum": -2147483648, "maximum": 2147483647}, "Temperature": {"type": "number", "description": "EOT, Engine oil temperature."}, "PressureStatus": {"type": "string", "description": "Engine oil pressure status.", "enum": ["NORMAL", "WARNING", "ALERT", "ERROR"]}}}, "EngineCoolant": {"type": "object", "description": "Signals related to the engine coolant", "properties": {"Capacity": {"type": "number", "description": "Engine coolant capacity in liters."}, "Temperature": {"type": "number", "description": "Engine coolant temperature."}, "Level": {"type": "string", "description": "Engine coolant level.", "enum": ["CRITICALLY_LOW", "LOW", "NORMAL"]}, "LifeRemaining": {"type": "integer", "description": "Remaining engine coolant life in seconds. Negative values can be used to indicate that lifetime has been exceeded.", "minimum": -2147483648, "maximum": 2147483647}}}, "MAP": {"type": "integer", "description": "Manifold absolute pressure possibly boosted using forced induction.", "minimum": 0, "maximum": 65535}, "MAF": {"type": "integer", "description": "Grams of air drawn into engine per second.", "minimum": 0, "maximum": 65535}, "TPS": {"type": "integer", "description": "Current throttle position.", "minimum": 0, "maximum": 100}, "EOP": {"type": "integer", "description": "Engine oil pressure.", "minimum": 0, "maximum": 65535}, "Power": {"type": "integer", "description": "Current engine power output. Shall be reported as 0 during engine breaking.", "minimum": 0, "maximum": 65535}, "Torque": {"type": "integer", "description": "Current engine torque. Shall be reported as a negative number during engine breaking.", "minimum": -32768, "maximum": 32767}, "DieselExhaustFluid": {"type": "object", "description": "Signals related to Diesel Exhaust Fluid (DEF). DEF is called AUS32 in ISO 22241.", "properties": {"Capacity": {"type": "number", "description": "Capacity in liters of the Diesel Exhaust Fluid Tank."}, "Level": {"type": "integer", "description": "Level of the Diesel Exhaust Fluid tank as percent of capacity. 0 = empty. 100 = full.", "minimum": 0, "maximum": 100}, "Range": {"type": "integer", "description": "Remaining range in meters of the Diesel Exhaust Fluid present in the vehicle.", "minimum": 0, "maximum": 4294967295}, "IsLevelLow": {"type": "boolean", "description": "Indicates if the Diesel Exhaust Fluid level is low. True if level is low. Definition of low is vehicle dependent."}}}, "DieselParticulateFilter": {"type": "object", "description": "Diesel Particulate Filter signals.", "properties": {"InletTemperature": {"type": "number", "description": "Inlet temperature of Diesel Particulate Filter."}, "OutletTemperature": {"type": "number", "description": "Outlet temperature of Diesel Particulate Filter."}, "DeltaPressure": {"type": "number", "description": "Delta Pressure of Diesel Particulate Filter."}}}}}, "Transmission": {"type": "object", "description": "Transmission-specific data, stopping at the drive shafts.", "properties": {"Type": {"type": "string", "description": "Transmission type.", "enum": ["UNKNOWN", "SEQUENTIAL", "H", "AUTOMATIC", "DSG", "CVT"]}, "GearCount": {"type": "integer", "description": "Number of forward gears in the transmission. -1 = CVT.", "minimum": -128, "maximum": 127}, "DriveType": {"type": "string", "description": "Drive type.", "enum": ["UNKNOWN", "FORWARD_WHEEL_DRIVE", "REAR_WHEEL_DRIVE", "ALL_WHEEL_DRIVE"]}, "TravelledDistance": {"type": "number", "description": "Odometer reading, total distance travelled during the lifetime of the transmission."}, "CurrentGear": {"type": "integer", "description": "The current gear. 0=Neutral, 1/2/..=Forward, -1/-2/..=Reverse.", "minimum": -128, "maximum": 127}, "SelectedGear": {"type": "integer", "description": "The selected gear. 0=Neutral, 1/2/..=Forward, -1/-2/..=Reverse, 126=Park, 127=Drive.", "minimum": -128, "maximum": 127}, "IsParkLockEngaged": {"type": "boolean", "description": "Is the transmission park lock engaged or not. False = Disengaged. True = Engaged."}, "IsLowRangeEngaged": {"type": "boolean", "description": "Is gearbox in low range mode or not. False = Normal/High range engaged. True = Low range engaged."}, "IsElectricalPowertrainEngaged": {"type": "boolean", "description": "Is electrical powertrain mechanically connected/engaged to the drivetrain or not. False = Disconnected/Disengaged. True = Connected/Engaged."}, "PerformanceMode": {"type": "string", "description": "Current gearbox performance mode.", "enum": ["NORMAL", "SPORT", "ECONOMY", "SNOW", "RAIN"]}, "GearChangeMode": {"type": "string", "description": "Is the gearbox in automatic or manual (paddle) mode.", "enum": ["MANUAL", "AUTOMATIC"]}, "Temperature": {"type": "number", "description": "The current gearbox temperature."}, "ClutchEngagement": {"type": "number", "description": "Clutch engagement. 0% = Clutch fully disengaged. 100% = Clutch fully engaged.", "minimum": 0, "maximum": 100}, "ClutchWear": {"type": "integer", "description": "Clutch wear as a percent. 0 = no wear. 100 = worn.", "minimum": 0, "maximum": 100}, "DiffLockFrontEngagement": {"type": "number", "description": "Front Diff Lock engagement. 0% = Diff lock fully disengaged. 100% = Diff lock fully engaged.", "minimum": 0, "maximum": 100}, "DiffLockRearEngagement": {"type": "number", "description": "Rear Diff Lock engagement. 0% = Diff lock fully disengaged. 100% = Diff lock fully engaged.", "minimum": 0, "maximum": 100}, "TorqueDistribution": {"type": "number", "description": "Torque distribution between front and rear axle in percent. -100% = Full torque to front axle, 0% = 50:50 Front/Rear, 100% = Full torque to rear axle.", "minimum": -100, "maximum": 100}}}, "ElectricMotor": {"type": "object", "description": "Electric Motor specific data.", "properties": {"Front": {"type": "object", "description": "Electric Motor specific data.", "properties": {"EngineCode": {"type": "string", "description": "Engine code designation, as specified by vehicle manufacturer."}, "MaxPower": {"type": "integer", "description": "Peak power, in kilowatts, that motor(s) can generate.", "minimum": 0, "maximum": 65535}, "MaxTorque": {"type": "integer", "description": "Peak power, in newton meter, that the motor(s) can generate.", "minimum": 0, "maximum": 65535}, "MaxRegenPower": {"type": "integer", "description": "Peak regen/brake power, in kilowatts, that motor(s) can generate.", "minimum": 0, "maximum": 65535}, "MaxRegenTorque": {"type": "integer", "description": "Peak regen/brake torque, in newton meter, that the motor(s) can generate.", "minimum": 0, "maximum": 65535}, "Speed": {"type": "number", "description": "Motor rotational speed measured as rotations per minute. Negative values indicate reverse driving mode."}, "TimeInUse": {"type": "number", "description": "Accumulated time during engine lifetime when the vehicule state's is 'READY'."}, "Temperature": {"type": "number", "description": "Motor temperature."}, "EngineCoolant": {"type": "object", "description": "Signals related to the engine coolant (if applicable).", "properties": {"Capacity": {"type": "number", "description": "Engine coolant capacity in liters."}, "Temperature": {"type": "number", "description": "Engine coolant temperature."}, "Level": {"type": "string", "desc