tion": "Indicates if light is on or off. True = On. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}, "Front": {"type": "object", "description": "Fog lights.", "properties": {"IsOn": {"type": "boolean", "description": "Indicates if light is on or off. True = On. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}}}, "LicensePlate": {"type": "object", "description": "License plate lights.", "properties": {"IsOn": {"type": "boolean", "description": "Indicates if light is on or off. True = On. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}, "Brake": {"type": "object", "description": "Brake lights.", "properties": {"IsActive": {"type": "string", "description": "Indicates if break-light is active. INACTIVE means lights are off. ACTIVE means lights are on. ADAPTIVE means that break-light is indicating emergency-breaking.", "enum": ["INACTIVE", "ACTIVE", "ADAPTIVE"]}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}, "Hazard": {"type": "object", "description": "Hazard lights.", "properties": {"IsSignaling": {"type": "boolean", "description": "Indicates if light is signaling or off. True = signaling. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}, "DirectionIndicator": {"type": "object", "description": "Indicator lights.", "properties": {"Left": {"type": "object", "description": "Indicator lights.", "properties": {"IsSignaling": {"type": "boolean", "description": "Indicates if light is signaling or off. True = signaling. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}, "Right": {"type": "object", "description": "Indicator lights.", "properties": {"IsSignaling": {"type": "boolean", "description": "Indicates if light is signaling or off. True = signaling. False = Off."}, "IsDefect": {"type": "boolean", "description": "Indicates if light is defect. True = Light is defect. False = Light has no defect."}}}}}}}, "Mirrors": {"type": "object", "description": "All mirrors.", "properties": {"DriverSide": {"type": "object", "description": "All mirrors.", "properties": {"Tilt": {"type": "integer", "description": "Mirror tilt as a percent. 0 = Center Position. 100 = Fully Upward Position. -100 = Fully Downward Position.", "minimum": -100, "maximum": 100}, "Pan": {"type": "integer", "description": "Mirror pan as a percent. 0 = Center Position. 100 = Fully Left Position. -100 = Fully Right Position.", "minimum": -100, "maximum": 100}, "Yaw": {"type": "integer", "description": "Relative mirror yaw angle, measured from the vehicle sprung mass X-axis as defined by ISO 23150:2023 to the mirror X-axis, around the vehicle Z-axis (right-hand rule). 0 = Mirror in default position. Exact position (yaw relative to vehicle X-axis) is vehicle dependent. 100 = Maximum yaw. Mirror rotated clockwise as much as possible around Z-axis. -100 = Minimum yaw. Mirror rotated counter-clockwise as much as possible around Z-axis.", "minimum": -100, "maximum": 100}, "IsHeatingOn": {"type": "boolean", "description": "Mirror Heater on or off. True = Heater On. False = Heater Off."}, "IsLocked": {"type": "boolean", "description": "Is mirror movement locked? True = Locked, mirror will not react to Tilt/Pan change. False = Unlocked."}, "IsFolded": {"type": "boolean", "description": "Is mirror folded? True = Fully or partially folded. False = Fully unfolded."}}}, "PassengerSide": {"type": "object", "description": "All mirrors.", "properties": {"Tilt": {"type": "integer", "description": "Mirror tilt as a percent. 0 = Center Position. 100 = Fully Upward Position. -100 = Fully Downward Position.", "minimum": -100, "maximum": 100}, "Pan": {"type": "integer", "description": "Mirror pan as a percent. 0 = Center Position. 100 = Fully Left Position. -100 = Fully Right Position.", "minimum": -100, "maximum": 100}, "Yaw": {"type": "integer", "description": "Relative mirror yaw angle, measured from the vehicle sprung mass X-axis as defined by ISO 23150:2023 to the mirror X-axis, around the vehicle Z-axis (right-hand rule). 0 = Mirror in default position. Exact position (yaw relative to vehicle X-axis) is vehicle dependent. 100 = Maximum yaw. Mirror rotated clockwise as much as possible around Z-axis. -100 = Minimum yaw. Mirror rotated counter-clockwise as much as possible around Z-axis.", "minimum": -100, "maximum": 100}, "IsHeatingOn": {"type": "boolean", "description": "Mirror Heater on or off. True = Heater On. False = Heater Off."}, "IsLocked": {"type": "boolean", "description": "Is mirror movement locked? True = Locked, mirror will not react to Tilt/Pan change. False = Unlocked."}, "IsFolded": {"type": "boolean", "description": "Is mirror folded? True = Fully or partially folded. False = Fully unfolded."}}}}}, "RearMainSpoilerPosition": {"type": "number", "description": "Rear spoiler position, 0% = Spoiler fully stowed. 100% = Spoiler fully exposed.", "minimum": 0, "maximum": 100}, "PowerOptimizeLevel": {"type": "integer", "description": "Power optimization level for this branch/subsystem. A higher number indicates more aggressive power optimization. Level 0 indicates that all functionality is enabled, no power optimization enabled. Level 10 indicates most aggressive power optimization mode, only essential functionality enabled.", "minimum": 0, "maximum": 10}, "IsAutoPowerOptimize": {"type": "boolean", "description": "Auto Power Optimization Flag When set to 'true', the system enables automatic power optimization, dynamically adjusting the power optimization level based on runtime conditions or features managed by the OEM. When set to 'false', manual control of the power optimization level is allowed."}}}, "Cabin": {"type": "object", "description": "All in-cabin components, including doors.", "properties": {"RearShade": {"type": "object", "description": "Rear window shade. Open = Retracted, Closed = Deployed. Start position for RearShade is Open/Retracted.", "properties": {"IsOpen": {"type": "boolean", "description": "Is item open or closed? True = Fully or partially open. False = Fully closed."}, "Position": {"type": "integer", "description": "Item position. 0 = Start position 100 = End position.", "minimum": 0, "maximum": 100}, "Switch": {"type": "string", "description": "Switch controlling sliding action such as window, sunroof, or blind.", "enum": ["INACTIVE", "CLOSE", "OPEN", "ONE_SHOT_CLOSE", "ONE_SHOT_OPEN"]}}}, "HVAC": {"type": "object", "description": "Climate control", "properties": {"Station": {"type": "object", "description": "HVAC for single station in the vehicle", "properties": {"Row1": {"type": "object", "description": "HVAC for single station in the vehicle", "properties": {"Driver": {"type": "object", "description": "HVAC for single station in the vehicle", "properties": {"FanSpeed": {"type": "integer", "description": "Fan Speed, 0 = off. 100 = max", "minimum": 0, "maximum": 100}, "Temperature": {"type": "number", "description": "Temperature"}, "AirDistribution": {"type": "string", "description": "Direction of airstream", "enum": ["UP", "MIDDLE", "DOWN"]}}}, "Passenger": {"type": "object", "description": "HVAC for single station in the vehicle", "properties": {"FanSpeed": {"type": "integer", "description": "Fan Speed, 0 = off. 100 = max", "minimum": 0, "maximum": 100}, "Temperature": {"type": "number", "description": "Temperature"}, "AirDistribution": {"type": "string", "description": "Direction of airstream", "enum": ["UP", "MIDDLE", "DOWN"]}}}}}, "Row2": {"type": "object", "description": "HVAC for sing