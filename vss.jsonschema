ion": "Mass concentration of particulate matter with aerodynamic diameter of 1 micrometer or less (PM1.0).", "minimum": 0}, "PM25": {"type": "number", "description": "Mass concentration of particulate matter with aerodynamic diameter of 2.5 micrometers or less (PM2.5).", "minimum": 0}, "PM10": {"type": "number", "description": "Mass concentration of particulate matter with aerodynamic diameter of 10 micrometers or less (PM10).", "minimum": 0}, "CO2": {"type": "number", "description": "Carbon dioxide (CO2) concentration.", "minimum": 0}, "NO2": {"type": "number", "description": "Nitrogen dioxide (NO2) concentration.", "minimum": 0}, "Ozone": {"type": "number", "description": "Ozone (O3) concentration.", "minimum": 0}, "TVOC": {"type": "number", "description": "Total volatile organic compounds (TVOC) concentration.", "minimum": 0}}}, "Infotainment": {"type": "object", "description": "Infotainment system.", "properties": {"Media": {"type": "object", "description": "All Media actions", "properties": {"Action": {"type": "string", "description": "Tells if the media was", "enum": ["UNKNOWN", "STOP", "PLAY", "FAST_FORWARD", "FAST_BACKWARD", "SKIP_FORWARD", "SKIP_BACKWARD"]}, "Played": {"type": "object", "description": "Collection of signals updated in concert when a new media is played", "properties": {"Source": {"type": "string", "description": "Media selected for playback", "enum": ["UNKNOWN", "SIRIUS_XM", "AM", "FM", "DAB", "TV", "CD", "DVD", "AUX", "USB", "DISK", "BLUETOOTH", "INTERNET", "VOICE", "BEEP"]}, "Genre": {"type": "string", "description": "Name of genre being played"}, "Artist": {"type": "string", "description": "Name of artist being played"}, "Album": {"type": "string", "description": "Name of album being played"}, "Track": {"type": "string", "description": "Name of track being played"}, "URI": {"type": "string", "description": "User Resource associated with the media"}, "PlaybackRate": {"type": "number", "description": "Current playback rate of media being p