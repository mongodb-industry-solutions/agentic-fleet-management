perties": {"Brake": {"type": "object", "description": "Brake signals for wheel", "properties": {"FluidLevel": {"type": "integer", "description": "Brake fluid level as percent. 0 = Empty. 100 = Full.", "minimum": 0, "maximum": 100}, "IsFluidLevelLow": {"type": "boolean", "description": "Brake fluid level status. True = Brake fluid level low. False = Brake fluid level OK."}, "PadWear": {"type": "integer", "description": "Brake pad wear as percent. 0 = No Wear. 100 = Worn.", "minimum": 0, "maximum": 100}, "IsBrakesWorn": {"type": "boolean", "description": "Brake pad wear status. True = Worn. False = Not Worn."}}}, "Tire": {"type": "object", "description": "Tire signals for wheel.", "properties": {"Pressure": {"type": "integer", "description": "Tire pressure in kilo-Pascal.", "minimum": 0, "maximum": 65535}, "IsPressureLow": {"type": "boolean", "description": "Tire Pressure Status. True = Low tire pressure. False = Good tire pressure."}, "Temperature": {"type": "number", "description": "Tire temperature in Celsius."}, "RubberTemperature": {"type": "number", "description": "Rubber temperature of the tire in Celsius."}, "AirTemperature": {"type": "number", "description": "Air temperature inside the tire in Celsius."}, "WinterStatus": {"type": "string", "description": "Winter (cold-weather / snow) capability class of the tire currently fitted to this wheel.", "enum": ["UNKNOWN", "NON_WINTER", "WINTER"]}}}, "Speed": {"type": "number", "description": "Linear speed of a vehicle's wheel."}, "AngularSpeed": {"type": "number", "description": "Angular (Rotational) speed of a vehicle's wheel."}, "Torque": {"type": "integer", "description": "Torque provided by drivetrain, excluding torque provided by friction brakes. Negative values indicate regen mode.", "minimum": -32768, "maximum": 32767}}}}}}}}}, "AxleCount": {"type": "integer", "description": "Number of axles on the vehicle", "minimum": 0, "maximum": 255}, "ParkingBrake": {"type": "object", "description": "Parking brake signals", "properties": {"IsEngaged": {"type": "boolean", "description": "Parking brake status. True = Parking Brake is Engaged. False = Parking Brake is not Engaged."}, "IsAutoApplyEnabled": {"type": "boolean", "description": "Indicates if parking brake will be automatically engaged when the vehicle engine is turned off."}}}, "SteeringWheel": {"type": "object", "description": "Steering wheel signals", "properties": {"Angle": {"type": "integer", "description": "Steering wheel angle. Positive = degrees to the left. Negative = degrees to the right.", "minimum": -32768, "maximum": 32767}, "Tilt": {"type": "integer", "description": "Steering wheel column tilt. 0 = Lowest position. 100 = Highest position.", "minimum": 0, "maximum": 100}, "Extension": {"type": "integer", "description": "Steering wheel column extension from dashboard. 0 = Closest to dashboard. 100 = Furthest from dashboard.", "minimum": 0, "maximum": 100}, "HeatingCooling": {"type": "integer", "description": "Heating or Cooling requsted for the Item. -100 = Maximum cooling, 0 = Heating/cooling deactivated, 100 = Maximum heating.", "minimum": -100, "maximum": 100}}}, "Accelerator": {"type": "object", "description": "Accelerator signals", "properties": {"PedalPosition": {"type": "integer", "description": "Accelerator pedal position as percent. 0 = Not depressed. 100 = Fully depressed.", "minimum": 0, "maximum": 100}}}, "Brake": {"type": "object", "description": "Brake system signals", "properties": {"PedalPosition": {"type": "integer", "description": "Brake pedal position as percent. 0 = Not depressed. 100 = Fully depressed.", "minimum": 0, "maximum": 100}, "IsDriverEmergencyBrakingDetected": {"type": "boolean", "description": "Indicates if emergency braking initiated by driver is detected. True = Emergency braking detected. False = Emergency braking not detected."}}}}}, "Driver": {"type": "object", "description": "Driver data.", "properties": {"DistractionLevel": {"type": "number", "description": "Distraction level of the driver, which can be evaluated by multiple factors e.g. driving situation, acoustical or optical signals inside the cockpit, ongoing phone calls.", "minimum": 0, "maximum": 100}, "IsEyesOnRoad": {"type": "boolean", "description": "Has driver the eyes on road or not?"}, "IsHandsOnWheel": {"type": "boolean", "description": "Are the driver's hands on the steering wheel or not?"}, "AttentiveProbability": {"type": "number", "description": "Probability of attentiveness of the driver.", "minimum": 0, "maximum": 100}, "FatigueLevel": {"type": "number", "description": "Fatigue level of the driver, which can be evaluated by multiple factors e.g. trip time, behaviour of steering, eye status.", "minimum": 0, "maximum": 100}, "HeartRate": {"type": "integer", "description": "Heart rate of the driver.", "minimum": 0, "maximum": 65535}}}, "Occupant": {"type": "object", "description": "Occupant (Driver or Passenger) data.", "properties": {"Row1": {"type": "object", "description": "Occupant (Driver or Passenger) data.", "properties": {"DriverSide": {"type": "object", "description": "Occupant (Driver or Passenger) data.", "properties": {"Identifier": {"type": "object", "description": "Identifier attributes based on OAuth 2.0.", "properties": {"Subject": {"type": "string", "description": "Subject for the authentication of the occupant e.g. UserID 7331677."}, "Issuer": {"type": "string", "description": "Unique Issuer for the authentication of the occupant e.g. https://accounts.funcorp.com."}}}, "HeadPosition": {"type": "object", "description": "The current position of the driver head on vehicle axis according to ISO 23150:2023.", "properties": {"X": {"type": "integer", "description": "Longitudinal position of head center measured as mid eye position on X-axis of the vehicle rear-axle coordinate system as defined by ISO 23150:2023 section 3.7.12 Mid eye position refers to the center of a line drawn between the center of the drivers eyes. Positive values = forward of (first) rea