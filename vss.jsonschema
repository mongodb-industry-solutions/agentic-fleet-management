umber", "description": "Current minimum temperature of the battery cells, i.e. temperature of the coldest cell."}, "Max": {"type": "number", "description": "Current maximum temperature of the battery cells, i.e. temperature of the hottest cell."}, "CellTemperature": {"type": "array", "description": "Array of cell temperatures. Length or array shall correspond to number of cells in vehicle.", "items": {"type": "number"}}}}, "CellVoltage": {"type": "object", "description": "Voltage information for cells in the battery pack.", "properties": {"Min": {"type": "number", "description": "Current voltage of the battery cell with lowest voltage."}, "IdMin": {"type": "integer", "description": "Identifier of the battery cell with lowest voltage.", "minimum": 0, "maximum": 65535}, "Max": {"type": "number", "description": "Current voltage of the battery cell with highest voltage."}, "IdMax": {"type": "integer", "description": "Identifier of the battery cell with highest voltage.", "minimum": 0, "maximum": 65535}, "CellVoltages": {"type": "array", "description": "Array of cell voltages. Length or array shall correspond to number of cells in vehicle.", "items": {"type": "number"}}}}, "GrossCapacity": {"type": "integer", "description": "Gross capacity of the battery.", "minimum": 0, "maximum": 65535}, "NetCapacity": {"type": "integer", "description": "Total net capacity of the battery considering aging.", "minimum": 0, "maximum": 65535}, "StateOfHealth": {"type": "number", "description": "Calculated battery state of health at standard conditions.", "minimum": 0, "maximum": 100}, "StateOfCharge": {"type": "object", "description": "Information on the state of charge of the vehicle's high voltage battery.", "properties": {"Current": {"type": "number", "description": "Physical state of charge of the high voltage battery, relative to net capacity. This is not necessarily the state of charge being displayed to the customer.", "minimum": 0, "maximum": 100.0}, "Displayed": {"type": "number", "description": "State of charge displayed to the customer.", "minimum": 0, "maximum": 100.0}, "CurrentEnergy": {"type": "number", "description": "Physical state of charge of high voltage battery expressed in kWh."}}}, "NominalVoltage": {"type": "integer", "description": "Nominal Voltage of the battery.", "minimum": 0, "maximum": 65535}, "MaxVoltage": {"type": "integer", "description": "Max allowed voltage of the battery, e.g. during charging.", "minimum": 0, "maximum": 65535}, "CurrentVoltage": {"type": "number", "description": "Current Voltage of the battery."}, "CurrentCurrent": {"type": "number", "description": "Current current flowing in/out of battery. Positive = Current flowing in to battery, e.g. during charging. Negative = Current flowing out of battery, e.g. during driving."}, "CurrentPower": {"type": "number", "description": "Current electrical energy flowing in/out of battery. Positive = Energy flowing in to battery, e.g. during charging. Negative = Energy flowing out of battery, e.g. during driving."}, "AccumulatedChargedEnergy": {"type": "number", "description": "The accumulated energy delivered to the battery during charging over lifetime of the battery."}, "AccumulatedConsumedEnergy": {"type": "number", "description": "The accumulated energy leaving HV battery for propulsion and auxiliary loads over lifetime of the battery."}, "AccumulatedChargedThroughput": {"type": "number", "description": "The accumulated charge throughput delivered to the battery during charging over lifetime of the battery."}, "AccumulatedConsumedThroughput": {"type": "number", "description": "The accumulated charge throughput leaving HV battery for propulsion and auxiliary loads over lifetime of the battery."}, "PowerLoss": {"type": "number", "description": "Electrical energy lost by power dissipation to heat inside the battery."}, "Range": {"type": "integer", "description": "Remaining range in meters using only battery.", "minimum": 0, "maximum": 4294967295}, "TimeRemaining": {"type": "integer", "description": "Time remaining in seconds before the battery is empty.", "minimum": 0, "maximum": 4294967295}, "Charging": {"type": "object", "description": "Properties related to battery charging.", "properties": {"ChargingPort": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"FrontLeft": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "FrontMiddle": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "FrontRight": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "RearLeft": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "RearMiddle": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "RearRight": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}, "AnyPosition": {"type": "object", "description": "Properties related to a particular charging port available in the vehicle.", "properties": {"SupportedInletTypes": {"type": "array", "description": "A list of the supported (i.e., available) charging inlets in a particular charging port. IEC types refer to IEC 62196,  GBT refers to  GB/T 20234.", "items": {"type": "string", "enum": ["IEC_TYPE_1_AC", "IEC_TYPE_2_AC", "IEC_TYPE_3_AC", "IEC_TYPE_4_DC", "IEC_TYPE_1_CCS_DC", "IEC_TYPE_2_CCS_DC", "TESLA_ROADSTER", "TESLA_HPWC", "TESLA_SUPERCHARGER", "GBT_AC", "GBT_DC", "OTHER"]}}, "IsFlapOpen": {"type": "boolean", "description": "Status of the charging port flap(s)."}, "IsChargingCableConnected": {"type": "boolean", "description": "Indicates whether a charging cable is physically connected to a particular charging port or not."}, "IsChargingCableLocked": {"type": "boolean", "description": "Is charging cable locked to prevent removal."}}}}}, "ChargeLimit": {"type": "integer", "description": "Target charge limit (state of charge) for battery.", "minimum": 0, "maximum": 100}, "MaximumChargingCurrent": {"type": "object", "description": "Maximum charging current that can be accepted by the system, as measured at the charging inlet.", "properties": {"DC": {"type": "number", "description": "Maximum DC charging current at inlet that can be accepted by the system."}, "Phase1": {"type": "number", "description": "Maximum AC charging current (rms) at inlet for Phase 1 that can be accepted by the system."}, "Phase2": {"type": "number", "description": "Maximum AC charging current (rms) at inlet for Phase 2 that can be accepted by the system."}, "Phase3": {"type": "number", "description": "Maximum AC charging current (rms) at inlet for Phase 3 that can be accepted by the system."}}}, "IsCharging": {"type": "boolean", "description": "True if charging is ongoing. Charging is considered to be ongoing if energy is flowing from charger to vehicle."}, "IsDischarging": {"type": "boolean", "description": "True if discharging (vehicle to grid) is ongoing. Discharging is considered to be ongoing if energy is flowing from vehicle to charger/grid."}, "StartStopCharging": {"type": "string", "description": "Start or stop the charging process.", "enum": ["START", "STOP"]}, "ChargeCurrent": {"type": "object", "description": "Current charging current.", "properties": {"DC": {"type": "number", "description": "Current DC charging current at inlet. Negative if returning energy to grid."}, "Phase1": {"type": "number", "description": "Current AC charging current (rms) at inlet for Phase 1. Negative if returning energy to grid."}, "Phase2": {"type": "number", "description": "Current AC charging current (rms) at inlet for Phase 2. Negative if returning energy to grid."}, "Phase3": {"type": "number", "description": "Current AC charging current (rms) at inlet for Phase 3. Negative if returning energy to grid."}}}, "ChargeVoltage": {"type": "object", "description": "Current charging voltage, as measured at the charging inlet.", "properties": {"DC": {"type": "number", "description": "Current DC charging voltage at charging inlet."}, "Phase1": {"type": "number", "description": "Current AC charging voltage (rms) at inlet for Phase 1."}, "Phase2": {"type": "number", "description": "Current AC charging voltage (rms) at inlet for Phase 2."}, "Phase3": {"type": "number", "description": "Current AC charging voltage (rms) at inlet for Phase 3."}}}, "AveragePower": {"type": "number", "description": "Average charging power of last or current charging event."}, "MaxPower": {"type": "number", "description": "Maximum charging power of last or current charging event."}, "EvseId": {"type": "string", "description": "EVSE charging point ID (without separators) of last or current charging event according to ISO 15118-2 Annex H."}, "Location": {"type": "object", "description": "Location of last or current charging event.", "properties": {"Latitude": {"type": "number", "description": "Latitude of last or current charging event in WGS 84 geodetic coordinates.", "minimum": -90, "maximum": 90}, "Longitude": {"type": "number", "description": "Longitude of last or current charging event in WGS 84 geodetic coordinates.", "minimum": -180, "maximum": 180}, "Altitude": {"type": "number", "description": "Altitude relative to WGS 84 reference ellipsoid of last or current charging event."}}}, "PowerLoss": {"type": "number", "description": "Electrical energy lost by power dissipation to heat inside the AC/DC converter."}, "Temperature": {"type": "number", "description": "Current temperature of AC/DC converter converting grid voltage to battery voltage."}, "ChargeRate": {"type": "number", "description": "Current charging rate, as in kilometers of range added per hour."}, "TimeToComplete": {"type": "integer", "description": "The time needed for the current charging process to reach Charging.ChargeLimit. 0 if charging is complete or no charging process is active or planned.", "minimum": 0, "maximum": 4294967295}, "Timer": {"type": "object", "description": "Properties related to timing of battery charging sessions.", "properties": {"Mode": {"type": "string", "description": "Defines timer mode for charging: INACTIVE - no timer set, charging may start as soon as battery is connected to a charger. START_TIME - charging shall start at Charging.Timer.Time. END_TIME - charging shall be finished (reach Charging.ChargeLimit) at Charging.Timer.Time. When charging is completed the vehicle shall change mode to 'inactive' or set a new Charging.Timer.Time. Charging shall start immediately if mode is 'starttime' or 'endtime' and Charging.Timer.Time is a time in the past.", "enum": ["INACTIVE", "START_TIME", "END_TIME"]}, "Time": {"type": "string", "description": "Time for next charging-related action, formatted according to ISO 8601 with UTC time zone. Value has no significance if Charging.Timer.Mode is 'inactive'."}}}}}, "DCDC": {"type": "object", "description": "Properties related to DC/DC converter converting high voltage (from high voltage battery) to vehicle low voltage (supply voltage, typically 12 Volts).", "properties": {"PowerLoss": {"type": "number", "description": "Electrical energy lost by power dissipation to heat inside DC/DC converter."}, "Temperature": {"type": "number", "description": "Current temperature of DC/DC converter converting battery high voltage to vehicle low voltage (typically 12 Volts)."}}}, "BatteryConditioning": {"type": "object", "description": "Properties related to preparing the vehicle battery for charging or driving.", "properties": {"IsActive": {"type": "boolean", "description": "Indicates if battery conditioning is active (i.e. actively monitors battery temperature). True = Active. False = Inactive."}, "IsOngoing": {"type": "boolean", "description": "Indicating if battery conditioning is currently ongoing. Battery conditioning is considered ongoing when the battery conditioning system is actively heating or cooling the battery, or requesting heating or cooling."}, "RequestedMode": {"type": "string", "description": "Defines requested mode for battery conditioning. INACTIVE - Battery conditioning inactive. FAST_CHARGING_PREPARATION - Battery conditioning for fast charging. DRIVING_PREPARATION - Battery conditioning for driving.", "enum": ["INACTIVE", "FAST_CHARGING_PREPARATION", "DRIVING_PREPARATION"]}, "StartTime": {"type": "string", "description": "Start time for battery conditioning, formatted according to ISO 8601 with UTC time zone."}, "TargetTime": {"type": "string", "description": "Target time when conditioning shall be finished, formatted according to ISO 8601 with UTC time zone."}, "TargetTemperature": {"type": "number", "description": "Target temperature for battery conditioning."}}}}}, "FuelSystem": {"type": "object", "description": "Fuel system data.", "properties": {"SupportedFuelTypes": {"type": "array", "description": "High level information of fuel types supported", "items": {"type": "string", "enum": ["GASOLINE", "DIESEL", "E85", "LPG", "CNG", "LNG", "H2", "OTHER"]}}, "SupportedFuel": {"type": "array", "description": "Detailed information on fuels supported by the vehicle. Identifiers originating from DIN EN 16942:2021-08, appendix B, with additional suffix for octane (RON) where relevant.", "items": {"type": "string", "enum": ["E5_95", "E5_98", "E10_95", "E10_98", "E85", "B7", "B10", "B20", "B30", "B100", "XTL", "LPG", "CNG", "LNG", "H2", "OTHER"]}}, "HybridType": {"type": "string", "description": "Defines the hybrid type of the vehicle.", "enum": ["UNKNOWN", "NOT_APPLICABLE", "STOP_START", "BELT_ISG", "CIMG", "PHEV"]}, "TankCapacity": {"type": "number", "description": "Capacity of the fuel tank in liters."}, "AbsoluteLevel": {"type": "number", "description": "Current available fuel in the fuel tank expressed in liters."}, "RelativeLevel": {"type": "integer", "description": "Level in fuel tank as percent of capacity. 0 = empty. 100 = full.", "minimum": 0, "maximum": 100}, "Range": {"type": "integer", "description": "Remaining range in meters using only liquid fuel.", "minimum": 0, "maximum": 4294967295}, "TimeRemaining": {"type": "integer", "description": "Time remaining in seconds before the fuel tank is empty.", "minimum": 0, "maximum": 4294967295}, "InstantConsumption": {"type": "number", "description": "Current consumption in liters per 100 km.", "minimum": 0}, "AverageConsumption": {"type": "number", "description": "Average consumption in liters per 100 km.", "minimum": 0}, "ConsumptionSinceStart": {"type": "number", "description": "Fuel amount in liters consumed since start of current trip."}, "ConsumptionSinceLastRefuel": {"type": "number", "description": "Fuel consumption since last refueling."}, "IsEngineStopStartEnabled": {"type": "boolean", "description": "Indicates whether eco start stop is currently enabled."}, "IsFuelLevelLow": {"type": "boolean", "description": "Indicates that the fuel level is low (e.g. <50km range)."}, "IsFuelLevelEmpty": {"type": "boolean", "description": "Indicates that the fuel gauge on the instrument cluster displays empty (0)."}, "RefuelPortPosition": {"type": "array", "description": "Position of refuel port(s). First part indicates side of vehicle, second part relative position on that side.", "items": {"type": "string", "enum": ["FRONT_LEFT", "FRONT_MIDDLE", "FRONT_RIGHT", "REAR_LEFT", "REAR_MIDDLE", "REAR_RIGHT", "LEFT_FRONT", "LEFT_MIDDLE", "LEFT_REAR", "RIGHT_FRONT", "RIGHT_MIDDLE", "RIGHT_REAR"]}}, "IsFuelPortFlapOpen": {"type": "boolean", "description": "Status of the fuel port flap(s). True if at least one is open."}, "InstantantFuelEconomy": {"type": "number", "description": "Real-time instantaneous fuel economy calculated over a short time window."}, "InstantFuelEconomy": {"type": "number", "description": "Real-time instantaneous fuel economy calculated over a short time window."}, "CumulativeFuelEconomy": {"type": "number", "description": "Cumulative average fuel economy calculated from vehicle start or last user reset."}, "DriveFuelEconomy": {"type": "number", "description": "Average fuel economy for the current drive cycle, calculated from engine start to current time."}, "AfterRefuelingFuelEconomy": {"type": "number", "description": "Average fuel economy calculated from the most recent refueling event to the current time."}}}, "RangeExtender": {"type": "object", "description": "Extended Range Electric Vehicle (EREV) specific data.", "properties": {"OperatingMode": {"type": "string", "description": "Current operating mode of the Extended Range Electric Vehicle.", "enum": ["CHARGE_DEPLETING", "CHARGE_SUSTAINING", "BLENDED"]}, "ChargeDepleting": {"type": "object", "description": "Signals related to Charge Depleting (CD) mode operation.", "properties": {"EnergyConsumption": {"type": "number", "description": "Current electric energy consumption rate during Charge Depleting mode operation."}, "Range": {"type": "integer", "description": "Estimated remaining distance that can be traveled in Charge Depleting mode using available battery energy.", "minimum": 0, "maximum": 4294967295}}}, "ChargeSustaining": {"type": "object", "description": "Signals related to Charge Sustaining (CS) mode operation.", "properties": {"FuelEconomy": {"type": "number", "description": "Current fuel economy during Charge Sustaining mode operation."}, "Range": {"type": "integer", "description": "Estimated remaining distance that can be traveled in Charge Sustaining mode using available fuel.", "minimum": 0, "maximum": 4294967295}}}, "CombinedFuelEconomy": {"type": "number", "description": "Combined fuel economy equivalent that accounts for both electric energy and fuel consumption."}}}, "AccumulatedBrakingEnergy": {"type": "number", "description": "The accumulated energy from regenerative braking over lifetime."}, "Range": {"type": "integer", "description": "Remaining range in meters using all energy sources available in the vehicle.", "minimum": 0, "maximum": 4294967295}, "TimeRemaining": {"type": "integer", "description": "Time remaining in seconds before all energy sources available in the vehicle are empty.", "minimum": 0, "maximum": 4294967295}, "Type": {"type": "string", "description": "Defines the powertrain type of the vehicle.", "enum": ["COMBUSTION", "HYBRID", "ELECTRIC"]}, "PowerOptimizeLevel": {"type": "integer", "description": "Power optimization level for this branch/subsystem. A higher number indicates more aggressive power optimization. Level 0 indicates that all functionality is enabled, no power optimization enabled. Level 10 indicates most aggressive power optimization mode, only essential functionality enabled.", "minimum": 0, "maximum": 10}, "IsAutoPowerOptimize": {"type": "boolean", "description": "Auto Power Optimization Flag When set to 'true', the system enables automatic power optimization, dynamically adjusting the power optimization level based on runtime conditions or features managed by the OEM. When set to 'false', manual control of the power optimization level is allowed."}}}, "Body": {"type": "object", "description": "All body components.", "properties": {"BodyType": {"type": "string", "description": "Body type code as defined by ISO 3779."}, "Hood": {"type": "object", "description": "Hood status. Start position for Hood is Closed.", "properties": {"IsOpen": {"type": "boolean", "description": "Is item open or closed? True = Fully or partially open. False = Fully closed."}, "Position": {"type": "integer", "description": "Item position. 0 = Start position 100 = End position.", "minimum": 0, "maximum": 100}, "Switch": {"type": "string", "description": "Switch controlling sliding action such as window, sunroof, or blind.", "enum": ["INACTIVE", "CLOSE", "OPEN", "ONE_SHOT_CLOSE", "ONE_SHOT_OPEN"]}}}, "Trunk": {"type": "object", "description": "Trunk status. Start position for Trunk is Closed.", "properties": {"Front": {"type": "object", "description": "Trunk status. Start position for Trunk is Closed.", "properties": {"IsLightOn": {"type": "boolean", "description": "Is trunk light on"}, "IsLocked": {"type": "boolean", "description": "Is item locked or unlocked. True = Locked. False = Unlocked."}, "IsOpen": {"type": "boolean", "description": "Is item open or closed? True = Fully or partially open. False = Fully closed."}, "Position": {"type": "integer", "description": "Item position. 0 = Start position 100 = End position.", "minimum": 0, "maximum": 100}, "Switch": {"type": "string", "description": "Switch controlling sliding action such as window, sunroof, or blind.", "enum": ["INACTIVE", "CLOSE", "OPEN", "ONE_SHOT_CLOSE", "ONE_SHOT_OPEN"]}}}, "Rear": {"type": "object", "description": "Trunk status. Start position for Trunk is Closed.", "properties": {"IsLightOn": {"type": "boolean", "description": "Is trunk light on"}, "IsLocked": {"type": "boolean", "description": "Is item locked or unlocked. True = Locked. False = Unlocked."}, "IsOpen": {"type": "boolean", "description": "Is item open or closed? True = Fully or partially open. False = Fully closed."}, "Position": {"type": "integer", "description": "Item position. 0 = Start position 100 = End position.", "minimum": 0, "maximum": 100}, "Switch": {"type": "string", "description": "Switch controlling sliding action such as window, sunroof, or blind.", "enum": ["INACTIVE", "CLOSE", "OPEN", "ONE_SHOT_CLOSE", "ONE_SHOT_OPEN"]}}}}}, "Horn": {"type": "object", "description": "Horn signals.", "properties": {"IsActive": {"type": "boolean", "description": "Horn active or inactive. True = Active. False = Inactive."}}}, "Raindetection": {"type": "object", "description": "Rain sensor signals.", "properties": {"Intensity": {"type": "integer", "description": "Rain intensity. 0 = Dry, No Rain. 100 = Covered.", "minimum": 0, "maximum": 100}}}, "Windshield": {"type": "object", "description": "Windshield signals.", "properties": {"Front": {"type": "object", "description": "Windshield signals.", "properties": {"Wiping": {"type": "object", "description": "Windshield wiper signals.", "properties": {"Mode": {"type": "string", "description": "Wiper mode requested by user/driver. INTERVAL indicates intermittent wiping, with fixed time interval between each wipe. RAIN_SENSOR indicates intermittent wiping based on rain intensity.", "enum": ["OFF", "SLOW", "MEDIUM", "FAST", "INTERVAL", "RAIN_SENSOR"]}, "Intensity": {"type": "integer", "description": "Relative intensity/sensitivity for interval and rain sensor mode as requested by user/driver. Has no significance if Windshield.Wiping.Mode is OFF/SLOW/MEDIUM/FAST 0 - wipers inactive. 1 - minimum intensity (lowest frequency/sensitivity, longest interval). 2/3/4/... - higher intensity (higher frequency/sensitivity, shorter interval). Maximum value supported is vehicle specific.", "minimum": 0, "maximum": 255}, "System": {"type": "object", "description": "Signals to control behavior of wipers in detail. By default VSS expects only one instance.", "properties": {"Mode": {"type": "string", "description": "Requested mode of wiper system. STOP_HOLD means that the wipers shall move to position given by TargetPosition and then hold the position. WIPE means that wipers shall move to the position given by TargetPosition and then hold the position if no new TargetPosition is requested. PLANT_MODE means that wiping is disabled. Exact behavior is vehicle specific. EMERGENCY_STOP means that wiping shall be immediately stopped without holding the position.", "enum": ["STOP_HOLD", "WIPE", "PLANT_MODE", "EMERGENCY_STOP"]}, "Frequency": {"type": "integer", "description": "Wiping frequency/speed, measured in cycles per minute. The signal concerns the actual speed of the wiper blades when moving. Intervals/pauses are excluded, i.e. the value corresponds to the number of cycles that would be completed in 1 minute if wiping permanently over default range.", "minimum": 0, "maximum": 255}, "TargetPosition": {"type": "number", "description": "Requested position of main wiper blade for the wiper system relative to reference position. Location of reference position (0 degrees) and direction of positive/negative degrees is vehicle specific. System behavior when receiving TargetPosition depends on Mode and IsEndingWipeCycle. Supported values are vehicle specific and might be dynamically corrected. If IsEndingWipeCycle=True then wipers will complete current movement before actuating new TargetPosition. If IsEndingWipeCycle=False then wipers will directly change destination if the TargetPosition is changed."}, "ActualPosition": {"type": "number", "description": "Actual position of main wiper blade for the wiper system relative to reference position. Location of reference position (0 degrees) and direction of positive/negative degrees is vehicle specific."}, "DriveCurrent": {"type": "number", "description": "Actual current used by wiper drive."}, "IsWiping": {"type": "boolean", "description": "Indicates wiper movement. True if wiper blades are moving. Change of direction shall be considered as IsWiping if wipers will continue to move directly after the change of direction."}, "IsEndingWipeCycle": {"type": "boolean", "description": "Indicates if current wipe movement is completed or near completion. True = Movement is completed or near completion. Changes to RequestedPosition will be executed first after reaching previous RequestedPosition, if it has not already been reached. False = Movement is not near completion. Any change to RequestedPosition will be executed immediately. Change of direction may not be allowed."}, "IsWiperError": {"type": "boolean", "description": "Indicates system failure. True if wiping is disabled due to system failure."}, "IsPositionReached": {"type": "boolean", "description": "Indicates if a requested position has been reached. IsPositionReached refers to the previous position in case the TargetPosition is updated while IsEndingWipeCycle=True. True = Current or Previous TargetPosition reached. False = Position not (yet) reached, or wipers have moved away from the reached position."}, "IsBlocked": {"type": "boolean", "description": "Indicates if wiper movement is blocked. True = Movement blocked. False = Movement not blocked."}, "IsOverheated": {"type": "boolean", "description": "Indicates if wiper system is overheated. True = Wiper system overheated. False = Wiper system not overheated."}}}, "WiperWear": {"type": "integer", "description": "Wiper wear as percent. 0 = No Wear. 100 = Worn. Replacement required. Method for calculating or estimating wiper wear is vehicle specific. For windshields with multiple wipers the wear reported shall correspond to the most worn wiper.", "minimum": 0, "maximum": 100}, "IsWipersWorn": {"type": "boolean", "description": "Wiper wear status. True = Worn, Replacement recommended or required. False = Not Worn."}}}, "IsHeatingOn": {"type": "boolean", "description": "Windshield heater status. False - off, True - on."}, "WasherFluid": {"type": "object", "description": "Windshield washer fluid signals", "properties": {"IsLevelLow": {"type": "boolean", "description": "Low level indication for washer fluid. True = Level Low. False = Level OK."}, "Level": {"type": "integer", "description": "Washer fluid level as a percent. 0 = Empty. 100 = Full.", "minimum": 0, "maximum": 100}}}}}, "Rear": {"type": "object", "description": "Windshield signals.", "properties": {"Wiping": {"type": "object", "description": "Windshield wiper signals.", "properties": {"Mode": {"type": "string", "description": "Wiper mode requested by user/driver. INTERVAL indicates intermittent wiping, with fixed time interval between each wipe. RAIN_SENSOR indicates intermittent wiping based on rain intensity.", "enum": ["OFF", "SLOW", "MEDIUM", "FAST", "INTERVAL", "RAIN_SENSOR"]}, "Intensity": {"type": "integer", "description": "Relative intensity/sensitivity for interval and rain sensor mode as requested by user/driver. Has no significance if Windshield.Wiping.Mode is OFF/SLOW/MEDIUM/FAST 0 - wipers inactive. 1 - minimum intensity (lowest frequency/sensitivity, longest interval). 2/3/4/... - higher intensity (higher frequency/sensitivity, shorter interval). Maximum value supported is vehicle specific.", "minimum": 0, "maximum": 255}, "System": {"type": "object", "description": "Signals to control behavior of wipers in detail. By default VSS expects only one instance.", "properties": {"Mode": {"type": "string", "description": "Requested mode of wiper system. STOP_HOLD means that the wipers shall move to position given by TargetPosition and then hold the position. WIPE means that wipers shall move to the position given by TargetPosition and then hold the position if no new TargetPosition is requested. PLANT_MODE means that wiping is disabled. Exact behavior is vehicle specific. EMERGENCY_STOP means that wiping shall be immediately stopped without holding the position.", "enum": ["STOP_HOLD", "WIPE", "PLANT_MODE", "EMERGENCY_STOP"]}, "Frequency": {"type": "integer", "description": "Wiping frequency/speed, measured in cycles per minute. The signal concerns the actual speed of the wiper blades when moving. Intervals/pauses are excluded, i.e. the value corresponds to the number of cycles that would be completed in 1 minute if wiping permanently over default range.", "minimum": 0, "maximum": 255}, "TargetPosition": {"type": "number", "description": "Requested position of main wiper blade for the wiper system relative to reference position. Location of reference position (0 degrees) and direction of positive/negative degrees is vehicle specific. System behavior when receiving TargetPosition depends on Mode and IsEndingWipeCycle. Supported values are vehicle specific and might be dynamically corrected. If IsEndingWipeCycle=True then wipers will complete current movement before actuating new TargetPosition. If IsEndingWipeCycle=False then wipers will directly change destination if the TargetPosition is changed."}, "ActualPosition": {"type": "number", "description": "Actual position of main wiper blade for the wiper system relative to reference position. Location of reference position (0 degrees) and direction of positive/negative degrees is vehicle specific."}, "DriveCurrent": {"type": "number", "description": "Actual current used by wiper drive."}, "IsWiping": {"type": "boolean", "description": "Indicates wiper movement. True if wiper blades are moving. Change of direction shall be considered as IsWiping if wipers will continue to move directly after the change of direction."}, "IsEndingWipeCycle": {"type": "boolean", "description": "Indicates if current wipe movement is completed or near completion. True = Movement is completed or near completion. Changes to RequestedPosition will be executed first after reaching previous RequestedPosition, if it has not already been reached. False = Movement is not near completion. Any change to RequestedPosition will be executed immediately. Change of direction may not be allowed."}, "IsWiperError": {"type": "boolean", "description": "Indicates system failure. True if wiping is disabled due to system failure."}, "IsPositionReached": {"type": "boolean", "description": "Indicates if a requested position has been reached. IsPositionReached refers to the previous position in case the TargetPosition is updated while IsEndingWipeCycle=True. True = Current or Previous TargetPosition reached. False = Position not (yet) reached, or wipers have moved away from the reached position."}, "IsBlocked": {"type": "boolean", "description": "Indicates if wiper movement is blocked. True = Movement blocked. False = Movement not blocked."}, "IsOverheated": {"type": "boolean", "description": "Indicates if wiper system is overheated. True = Wiper system overheated. False = Wiper system not overheated."}}}, "WiperWear": {"type": "integer", "description": "Wiper wear as percent. 0 = No Wear. 100 = Worn. Replacement required. Method for calculating or estimating wiper wear is vehicle specific. For windshields with multiple wipers the wear reported shall correspond to the most worn wiper.", "minimum": 0, "maximum": 100}, "IsWipersWorn": {"type": "boolean", "description": "Wiper wear status. True = Worn, Replacement recommended or required. False = Not Worn."}}}, "IsHeatingOn": {"type": "boolean", "description": "Windshield heater status. False - off, True - on."}, "WasherFluid": {"type": "object", "description": "Windshield washer fluid signals", "properties": {"IsLevelLow": {"type": "boolean", "description": "Low level indication for washer fluid. True = Level Low. False = Level OK."}, "Level": {"type": "integer", "description": "Washer fluid level as a percent. 0 = Empty. 100 = Full.", "minimum": 0, "maximum": 100}}}}}}}, "Lights": {"type": "object", "description": "Exterior lights.", "properties": {"LightSwitch": {"type": "string", "description": "Status of the vehicle main light switch.", "enum": ["OFF", "POSITION", "DAYTIME_RUNNING_LIGHTS", "AUTO", "BEAM"]}